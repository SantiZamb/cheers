# Copy to .env.local (git-ignored) and fill in from your Supabase project's Connect dialog.
# The publishable (or legacy "anon") key is safe to ship in the app. Never put the secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
